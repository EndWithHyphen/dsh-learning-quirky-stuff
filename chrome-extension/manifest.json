{
  "manifest_version": 3,
  "name": "学习画板 · 快捷收藏",
  "version": "4.6.0",
  "description": "边看网页边记笔记，划词摘录原文，金句和截图自动同步到 DSH 学习画板。",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "sidePanel",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:43127/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开当前网页的侧边笔记",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "capture-note": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开当前网页的侧边学习笔记"
    },
    "studyboard-clip-selection": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "普通摘录 · 将选中文字保存到画布"
    },
    "studyboard-quote-selection": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "金句记录 · 保存原文并加入间隔复习"
    }
  },
  "minimum_chrome_version": "116",
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
